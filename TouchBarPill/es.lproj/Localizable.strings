/* Menú y etiqueta plegada. "Touch Bar" es el nombre del producto en los dos idiomas. */
"Touch Bar" = "Touch Bar";
"Touch Bar unavailable" = "Touch Bar no disponible";
"Try Again" = "Reintentar";
"Hide Touch Bar" = "Ocultar Touch Bar";
"Show Touch Bar" = "Mostrar Touch Bar";
